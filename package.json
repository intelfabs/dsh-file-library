{
  "name": "dsh-file-library",
  "version": "0.1.0",
  "private": false,
  "description": "A searchable library of every file ever sent to DeepSeek Harness, with one-click filing into the session workspace and reuse in any chat.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "file-library",
    "attachments",
    "file-search",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelfabs/dsh-file-library.git"
  },
  "homepage": "https://github.com/intelfabs/dsh-file-library#readme",
  "bugs": {
    "url": "https://github.com/intelfabs/dsh-file-library/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test test/index.test.mjs test/filing.test.mjs test/routes.test.mjs test/client.test.mjs test/host-smoke.test.mjs test/plugin.test.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
